DJANGO_ENV=shared
DEBUG=0
SECRET_KEY=replace-me-with-a-long-random-secret-key
ALLOWED_HOSTS=example.ru,www.example.ru
CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru
TIME_ZONE=Europe/Moscow

# Shared hosting database mode: mysql (recommended) or sqlite
DB_ENGINE=mysql
DB_NAME=example_db
DB_USER=example_db
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_CONN_MAX_AGE=30

# Uncomment only when you intentionally use SQLite instead of MySQL.
# DB_ENGINE=sqlite
# SQLITE_PATH=/home/u/user/site/data/db.sqlite3

MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_PIXELS=60000000
MAX_JSON_PAGE_SIZE=100
DELETE_ORIGINAL_AFTER_OPTIMIZE=1
FILE_UPLOAD_MAX_MEMORY_MB=2

# Disable these temporarily only during the very first HTTP-only smoke test.
SECURE_SSL_REDIRECT=1
CSRF_COOKIE_SECURE=1
SESSION_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
LOG_LEVEL=INFO

# The root wsgi.py auto-detects ../venv and the current public_html directory.
