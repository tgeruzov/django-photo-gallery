DJANGO_ENV=dev
DEBUG=1
SECRET_KEY=replace-me-with-a-long-random-secret-key-before-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1
# Начиная с Django 4.0 каждый origin обязан включать схему, например: https://example.com
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
LANGUAGE_CODE=ru

# Брендинг и SEO-метаданные сайта
SITE_NAME=Timur Geruzov
SITE_LOCALE=ru_RU
DEFAULT_META_DESCRIPTION=Авторская фотогалерея Тимура Герузова с полноэкранным просмотром, оптимизированной загрузкой и акцентом на визуальную подачу.

# postgresql (по умолчанию) или sqlite — для площадок без сервера БД;
# при sqlite остальные DB_* игнорируются, DB_NAME может задавать путь к файлу
DB_ENGINE=postgresql
DB_NAME=gallery
DB_USER=gallery
DB_PASSWORD=gallery
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

MAX_UPLOAD_SIZE_MB=100
MAX_IMAGE_PIXELS=100000000
MAX_JSON_PAGE_SIZE=200
# ВНИМАНИЕ: 1 = оригиналы фото удаляются БЕЗВОЗВРАТНО после генерации
# оптимизированной версии (останется только пережатый WEBP 2560px)
DELETE_ORIGINAL_AFTER_OPTIMIZE=0

ENABLE_BACKGROUND_TASKS=1
CELERY_TASK_ALWAYS_EAGER=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Кэш Django в prod (Redis уже есть в prod-compose)
REDIS_CACHE_URL=redis://localhost:6379/2
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=2592000
# Включать только при max-age >= 31536000 и стабильном HTTPS (условия hstspreload.org)
SECURE_HSTS_PRELOAD=0
# Число воркеров gunicorn в prod (примерно 2*CPU+1)
GUNICORN_WORKERS=3
LOG_LEVEL=INFO
