# Образец настроек. Скопируйте в .env и поменяйте значения: файл .env
# не попадает ни в git, ни в Docker-образ. Без .env локальный запуск
# работает на значениях по умолчанию.

# --- Локальный запуск (docker compose up) ---

# Порт галереи на компьютере: http://localhost:8000
WEB_PORT=8000
# Администратор создаётся при первом запуске, если его ещё нет
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
# Пароль базы задаётся при самом первом запуске. Чтобы сменить его потом,
# удалите том с базой (docker compose down -v, все фото в базе пропадут)
DB_PASSWORD=gallery

# --- Сервер (образ из Dockerfile) ---
# На сервере .env свой: в нём только строки ниже, без раздела выше.
# Контейнер получает его целиком: docker run --env-file .env ...
# Комментарии в этом формате только на отдельной строке, не после значения.

# Обязательные. SECRET_KEY - длинная случайная строка, например из
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# DEBUG=0
# SECRET_KEY=
# ALLOWED_HOSTS=photo.example.com
# CSRF_TRUSTED_ORIGINS=https://photo.example.com
# DB_HOST=db.example.com
# DB_NAME=gallery
# DB_USER=gallery
# DB_PASSWORD=

# Необязательные, здесь значения по умолчанию
# DB_PORT=5432
# MEDIA_ROOT=/app/media
# MAX_UPLOAD_SIZE_MB=100
# DELETE_ORIGINAL_AFTER_OPTIMIZE=0
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=2592000
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=3
