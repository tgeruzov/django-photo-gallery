# Пример .env для shared-хостинга Timeweb. Скопируйте в public_html/.env
# и подставьте реальные значения. Файл с секретами в репозиторий не коммитим.

DJANGO_ENV=shared
DEBUG=0

# Ключ обязателен и должен быть длинным/уникальным — иначе приложение не
# стартует. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Домены сайта (без схемы). У сайта привязаны два домена.
ALLOWED_HOSTS=tgeruzov.ru,www.tgeruzov.ru,arclume.ru,www.arclume.ru
# Для CSRF (Django 4+) — обязательно со схемой https://
CSRF_TRUSTED_ORIGINS=https://tgeruzov.ru,https://www.tgeruzov.ru,https://arclume.ru,https://www.arclume.ru

TIME_ZONE=Europe/Moscow
LANGUAGE_CODE=ru

# Брендинг/SEO
SITE_NAME=Timur Geruzov
SITE_LOCALE=ru_RU

# --- База данных (MySQL панели Timeweb) ---
DB_ENGINE=mysql
DB_NAME=co66275_djangophotogallery
DB_USER=co66275_djangophotogallery
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Загрузка/обработка изображений ---
# На shared-хостинге лимиты памяти/времени жёсткие — держим скромный лимит.
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_PIXELS=50000000
MAX_JSON_PAGE_SIZE=100
# ВНИМАНИЕ: 1 = оригиналы фото удаляются БЕЗВОЗВРАТНО после оптимизации.
DELETE_ORIGINAL_AFTER_OPTIMIZE=0

# --- Фоновые задачи (Celery на тарифе недоступен) ---
ENABLE_BACKGROUND_TASKS=0
CELERY_TASK_ALWAYS_EAGER=1

# --- HTTPS/безопасность ---
# Редирект на HTTPS уже делает панель Timeweb; Django-редирект оставляем выключенным.
SECURE_SSL_REDIRECT=0
# Включите (=1), только если после деплоя не работает вход в админку/CSRF
# (значит TLS терминируется на фронтенде и mod_wsgi видит http).
USE_FORWARDED_PROTO=0
# HSTS включайте, только когда HTTPS стабилен (>=31536000 для preload).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_PRELOAD=0

LOG_LEVEL=INFO
